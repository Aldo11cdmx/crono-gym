{
  "name": "cronos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cronos — Apple-inspired minimal dark-mode workout tracker",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:mapping": "esbuild src/lib/muscleMap.ts --bundle --format=cjs --platform=node --outfile=node_modules/.cache/muscleMap.cjs --log-level=error && node scripts/verifyMuscleMap.js",
    "equipment:map": "node scripts/generate-map.cjs"
  },
  "dependencies": {
    "@blobatar/react": "^2.7.0",
    "@supabase/supabase-js": "^2.45.0",
    "blobatar": "^2.7.0",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-muscle-highlighter": "^1.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
