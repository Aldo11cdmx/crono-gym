# Cronos environment variables.
# Copy this file to .env.local and fill in the real values from your
# Supabase project dashboard (Settings -> API).

VITE_SUPABASE_URL=https://xghhxyairaopppimnxrd.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhnaGh4eWFpcmFvcHBwaW1ueHJkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA4Nzc2NzYsImV4cCI6MjEwNjQ1MzY3Nn0.re6gTIP2nWS9mUr5d_2MMMxtzIJfY-7P9QGCVZ-Y1oI

# Source of the exercise catalog (1,324 records, ~17 MB JSON array).
# The dataset stores media as relative paths; this helper prefixes them
# with the raw GitHub base URL before caching.
VITE_EXERCISES_DATA_URL=https://raw.githubusercontent.com/hasaneyldrm/exercises-dataset/main/data/exercises.json

# COACH_JWT_SECRET is deliberately absent, and adding it here would be a mistake.
#
# Every variable above is `VITE_`-prefixed, which means Vite inlines it into the browser
# bundle -- that is fine for an anon key, whose entire purpose is to be public. This one
# signs coach session tokens, so a copy in this file would ship to every visitor and any
# one of them could mint a token for any coach.
#
# It belongs in the Edge Function's environment instead:
#   npx supabase secrets set COACH_JWT_SECRET="$(openssl rand -hex 32)" --project-id xghhxyairaopppimnxrd
# There is no default in coach-auth, deliberately: a fallback would be a shared secret
# across every deployment that forgot to set one.